{
  "name": "vlrc-fe-monorepo",
  "version": "2.7.0",
  "private": true,
  "description": "Monorepo for VLRC Frontend reusable component and hook libraries",
  "homepage": "https://github.com/vulinhnopro2704/vlrc-fe#readme",
  "bugs": {
    "url": "https://github.com/vulinhnopro2704/vlrc-fe/issues"
  },
  "license": "MIT",
  "author": "VLRC Platform Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulinhnopro2704/vlrc-fe.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter @vlrc-fe/components build && pnpm --filter @vlrc-fe/hooks build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:dev": "pnpm --filter @vlrc-fe/docs dev",
    "docs:build": "pnpm --filter @vlrc-fe/docs build",
    "docs:preview": "pnpm --filter @vlrc-fe/docs preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "simple-git-hooks",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@changesets/cli": "^3.0.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "ahooks": "^3.9.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "embla-carousel-react": "^8.6.0",
    "globals": "^17.6.0",
    "input-otp": "^1.4.2",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "sonner": "^2.0.7",
    "storybook": "^10.6.5",
    "tailwind-merge": "^3.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vaul": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt"
    ]
  }
}
