{
  "name": "vlrc-fe-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone monorepo for VLRC Frontend libraries",
  "type": "module",
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter @vlrc-fe/components build && pnpm --filter @vlrc-fe/hooks build",
    "lint": "eslint .",
    "publish:packages": "pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "ahooks": "^3.9.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "prettier": "3.8.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-number-format": "^5.4.5",
