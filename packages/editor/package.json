{
  "name": "@vlrc-fe/editor",
  "version": "1.0.1",
  "description": "Enterprise Notion-like Markdown and Rich-Text Editor built on Meta Lexical, Meta StyleX, and Astryx tokens.",
  "keywords": [
    "astryx",
    "block-editor",
    "editor",
    "lexical",
    "markdown",
    "meta-stylex",
    "notion",
    "rich-text",
    "stylex",
    "ui"
  ],
  "license": "MIT",
  "author": "VLRC Platform Team",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/theme/editor.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor.css": "./dist/theme/editor.css",
    "./theme/editor.css": "./dist/theme/editor.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && mkdir -p dist/theme && cp src/theme/editor.css dist/theme/editor.css",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@lexical/code": "^0.52.0",
    "@lexical/code-prism": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/hashtag": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@types/prismjs": "^1.26.6",
    "@vlrc-fe/components": "workspace:*",
    "lexical": "^0.52.0",
    "lucide-react": "^1.16.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vlrc-fe/components": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "@stylexjs/stylex": ">=0.19.0",
    "@vlrc-fe/components": ">=3.0.6",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
