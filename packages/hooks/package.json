{
  "name": "@vlrc-fe/hooks",
  "version": "1.2.0",
  "description": "Reusable React hooks for modal state, UI coordination, and animations.",
  "keywords": [
    "animation",
    "hooks",
    "modal",
    "react",
    "state-management",
    "utility"
  ],
  "homepage": "https://github.com/vulinhnopro2704/vlrc-fe/tree/main/packages/hooks#readme",
  "bugs": {
    "url": "https://github.com/vulinhnopro2704/vlrc-fe/issues"
  },
  "license": "MIT",
  "author": "VLRC Platform Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulinhnopro2704/vlrc-fe.git",
    "directory": "packages/hooks"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
