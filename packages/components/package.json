{
  "name": "@vlrc-fe/components",
  "version": "2.0.1",
  "description": "Reusable PlatformCore React components.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION_GUIDE.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./DataTable": {
      "types": "./dist/DataTable/index.d.ts",
      "import": "./dist/DataTable/index.js"
    },
    "./DataTable/*": {
      "types": "./dist/DataTable/*.d.ts",
      "import": "./dist/DataTable/*.js"
    },
    "./Icons": {
      "types": "./dist/Icons/index.d.ts",
      "import": "./dist/Icons/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./stylex.css": "./dist/assets/stylex.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@stylexjs/stylex": "^0.19.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "ahooks": "^3.9.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "embla-carousel-react": "^8.5.1",
    "input-otp": "^1.4.1",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "8.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
