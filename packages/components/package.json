{
  "name": "@vlrc-fe/components",
  "version": "3.0.1",
  "description": "Enterprise UI component library built on Meta's Astryx Design System, Meta StyleX, and Radix UI.",
  "keywords": [
    "accessible",
    "astryx",
    "components",
    "datatable",
    "design-system",
    "form-components",
    "meta-stylex",
    "radix-ui",
    "react",
    "react-hook-form",
    "stylex",
    "theming",
    "ui"
  ],
  "homepage": "https://github.com/vulinhnopro2704/vlrc-fe/tree/main/packages/components#readme",
  "bugs": {
    "url": "https://github.com/vulinhnopro2704/vlrc-fe/issues"
  },
  "license": "MIT",
  "author": "VLRC Platform Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulinhnopro2704/vlrc-fe.git",
    "directory": "packages/components"
  },
  "bin": {
    "astryx": "./bin/vlrc.mjs",
    "vlrc": "./bin/vlrc.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./DataTable": {
      "types": "./dist/DataTable/index.d.ts",
      "import": "./dist/DataTable/index.js"
    },
    "./DataTable/*": {
      "types": "./dist/DataTable/*.d.ts",
      "import": "./dist/DataTable/*.js"
    },
    "./Dropdown": {
      "types": "./dist/Dropdown/index.d.ts",
      "import": "./dist/Dropdown/index.js"
    },
    "./Icons": {
      "types": "./dist/Icons/index.d.ts",
      "import": "./dist/Icons/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.cjs"
    },
    "./Typography": {
      "types": "./dist/Typography/index.d.ts",
      "import": "./dist/Typography/index.js",
      "require": "./dist/Typography/index.cjs"
    },
    "./richtext": {
      "types": "./dist/richtext/index.d.ts",
      "import": "./dist/richtext/index.js",
      "require": "./dist/richtext/index.cjs"
    },
    "./astryx": {
      "types": "./dist/astryx.d.ts",
      "import": "./dist/astryx.js",
      "require": "./dist/astryx.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./vlrc-theme.css": "./dist/vlrc-theme.css",
    "./stylex.css": "./dist/assets/stylex.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && cat src/theme/theme.css dist/assets/stylex.css > dist/theme.css && cp src/theme/vlrc-theme.css dist/vlrc-theme.css",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/richtext": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-table": "^8.21.3",
    "ahooks": "^3.9.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "embla-carousel-react": "^8.5.1",
    "input-otp": "^1.4.1",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.16.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^2.0.7",
    "vaul": "^1.1.1"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.7.16",
    "@astryxdesign/cli": "0.7.16",
    "@stylexjs/unplugin": "^0.19.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8"
  },
  "peerDependenciesMeta": {
    "@stylexjs/stylex": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  }
}
