{
  "name": "@vlrc-fe/i18n",
  "version": "1.0.1",
  "description": "Standardized i18next instance factory and react-i18next re-exports",
  "keywords": [
    "i18n",
    "i18next",
    "internationalization",
    "localization",
    "react-i18next",
    "translation"
  ],
  "homepage": "https://github.com/vulinhnopro2704/vlrc-fe/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/vulinhnopro2704/vlrc-fe/issues"
  },
  "license": "MIT",
  "author": "VLRC Platform Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulinhnopro2704/vlrc-fe.git",
    "directory": "packages/i18n"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^24.2.2",
    "react-i18next": "^15.4.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
